# TextPlus environment template
# Add real values only in Vercel Project Settings > Environment Variables.
# Never commit real credentials or private keys to GitHub.

# Firebase client configuration (public web app configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio (server-only; never use NEXT_PUBLIC_ prefixes)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a provisioned SMS-capable number or a Messaging Service SID.
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Public HTTPS webhook URLs; must match the exact deployed, publicly reachable URLs.
TWILIO_INBOUND_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=

# Optional user-invoked assistant (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
