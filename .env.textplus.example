# TextPlus configuration template — values belong in Vercel Environment Variables, never commit real secrets.
# Authentication/database provider
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio (server-only; never prefix with NEXT_PUBLIC_)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Assistant (server-only)
AI_PROVIDER_API_KEY=

# Optional push notifications
FIREBASE_CLOUD_MESSAGING_SERVER_KEY=
